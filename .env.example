# Correo de contacto: Unpaywall lo exige para usar su API (la fuente OA más completa).
# Sin él, PaperFlow usa solo OpenAlex, Semantic Scholar, Europe PMC y Crossref.
PAPERFLOW_EMAIL=

# Opcional: prefijo del proxy de tu biblioteca (EZproxy u otro) para el botón "Acceso por mi biblioteca".
# Ejemplo: https://ezproxy.miuniversidad.edu/login?url=
PAPERFLOW_LIBRARY_PROXY=

# Tamaño máximo de PDF en MB
PAPERFLOW_MAX_MB=200

# Opcional: clave gratuita de CORE (https://core.ac.uk/services/api) para más consultas por minuto.
PAPERFLOW_CORE_KEY=
